
    digraph G {
        graph [splines=true];
        node [fontname="Arial"];
        edge [penwidth=1.5];
    "__start__" [label="__start__", shape=ellipse, style=filled, fillcolor=lightblue, width=0.5, height=0.3];"__end__" [label="__end__", shape=ellipse, style=filled, fillcolor=lightblue, width=0.5, height=0.3];"Joker" [label="Joker", shape=box, style=filled, fillcolor=lightyellow, width=1.5, height=0.8];"web_search_preview" [label="web_search_preview", shape=ellipse, style=filled, fillcolor=lightgreen, width=0.5, height=0.3];"pdf_creator_tool" [label="pdf_creator_tool", shape=ellipse, style=filled, fillcolor=lightgreen, width=0.5, height=0.3];"__start__" -> "Joker";
        "Joker" -> "web_search_preview" [style=dotted, penwidth=1.5];
        "web_search_preview" -> "Joker" [style=dotted, penwidth=1.5];
        "Joker" -> "pdf_creator_tool" [style=dotted, penwidth=1.5];
        "pdf_creator_tool" -> "Joker" [style=dotted, penwidth=1.5];"Joker" -> "__end__";}
